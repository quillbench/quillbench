# systemd user unit for Labelwise.
#   cp deploy/labelwise.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now labelwise
# Keeps running after logout only with lingering on: sudo loginctl enable-linger $USER
[Unit]
Description=Labelwise
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/labelwise
# Graph passwords for the Query Console (NEO4J_PASSWORD, ...), mode 600.
EnvironmentFile=-%h/.config/labelwise/labelwise.env
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/quillbench-env/bin/python -m labelwise serve
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
